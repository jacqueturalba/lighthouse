APP_NAME=LIGHTHOUSE
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila
APP_KEY=replace-with-a-random-32-character-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lighthouse_local
DB_USERNAME=root
DB_PASSWORD=
SESSION_NAME=lighthouse_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_PATH=storage/sessions
PASSWORD_RESET_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15
PASSWORD_MIN_LENGTH=12
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=LIGHTHOUSE
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
INITIAL_SUPER_ADMIN_PASSWORD=
